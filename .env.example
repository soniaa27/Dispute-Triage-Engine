# Copy to .env and adjust:  cp .env.example .env
# Every value here is injected at runtime by docker compose (env_file: .env).
# Nothing below is hardcoded in the code base.

# ---------- Logging ----------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------- PostgreSQL (runs, quarantine, feedback) ----------
# Used by the postgres container to initialise the database.
POSTGRES_USER=triage
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=triage
# SQLAlchemy URL used by api and worker. Keep user/password/db in sync with the above.
DATABASE_URL=postgresql+psycopg://triage:change-me-local-only@postgres:5432/triage

# ---------- Redis (job queue) ----------
REDIS_URL=redis://redis:6379/0
# RQ queue name shared by api (producer) and worker (consumer).
QUEUE_NAME=disputes

# ---------- Run execution ----------
# Wall-clock limit for one agent run inside the worker. Runs exceeding it are marked failed.
RUN_TIMEOUT_SECONDS=90

# ---------- API ----------
# Host port the API (and web client) is published on.
API_HOST_PORT=8000

# ---------- LLM gateway ----------
# Base URL the agent uses to reach the gateway (not used by the fake agent yet).
LLM_GATEWAY_URL=http://llm-gateway:8100
# stub    -> fixed response after STUB_DELAY_MS (use for dev and load tests)
# provider -> real provider (TODO, not implemented yet)
LLM_MODE=stub
# Provider name and model identifier, e.g. set when LLM_MODE=provider. Leave blank in stub mode.
LLM_PROVIDER=
LLM_MODEL=
# Never commit a real key. Set it only in your local .env.
LLM_API_KEY=
# Simulated provider latency for the stub, in milliseconds.
STUB_DELAY_MS=1500
# Price in USD per 1,000 tokens for the configured model, used to record cost per call.
# 0 in stub mode; set from the provider's price list when LLM_MODE=provider.
LLM_PRICE_PER_1K_PROMPT_TOKENS=0
LLM_PRICE_PER_1K_COMPLETION_TOKENS=0

# ---------- Agent loop limits (requirement A1) ----------
# A run that hits any limit stops and escalates instead of answering.
# Maximum graph steps (node executions) per run.
AGENT_MAX_STEPS=12
# Maximum tool calls (corpus search, clause lookup, request-field lookup) per run.
AGENT_MAX_TOOL_CALLS=20
# Wall-clock budget for the agent loop, in seconds. Must be below RUN_TIMEOUT_SECONDS (the
# worker's hard limit) so the agent can escalate cleanly before the worker marks the run failed.
AGENT_MAX_WALL_CLOCK_SECONDS=75
