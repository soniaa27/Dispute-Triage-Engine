# Copy to .env and adjust:  cp .env.example .env
# Every value here is injected at runtime by docker compose (env_file: .env).
# Nothing below is hardcoded in the code base.

# ---------- Logging ----------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------- PostgreSQL (runs, quarantine, feedback) ----------
# Used by the postgres container to initialise the database.
POSTGRES_USER=triage
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=triage
# SQLAlchemy URL used by api and worker. Keep user/password/db in sync with the above.
DATABASE_URL=postgresql+psycopg://triage:change-me-local-only@postgres:5432/triage

# ---------- Redis (job queue) ----------
REDIS_URL=redis://redis:6379/0
# RQ queue name shared by api (producer) and worker (consumer).
QUEUE_NAME=disputes

# ---------- Run execution ----------
# Wall-clock limit for one agent run inside the worker. Runs exceeding it are marked failed.
RUN_TIMEOUT_SECONDS=90

# ---------- API ----------
# Host port the API (and web client) is published on.
API_HOST_PORT=8000

# ---------- LLM gateway ----------
# docker compose passes the LLM_* settings below to the llm-gateway container only;
# the provider key never reaches api or worker. Details: docs/llm_gateway.md.

# Base URL the agent (worker) uses to reach the gateway inside compose.
LLM_GATEWAY_URL=http://llm-gateway:8100
# Host port for the gateway, bound to 127.0.0.1 only (eval judge, breaker demo).
LLM_GATEWAY_HOST_PORT=8100

# Provider: stub | gemini
#   stub   -> fixed response after STUB_DELAY_MS, no key needed (dev, CI, load tests)
#   gemini -> Google Gemini via the google-genai SDK; needs LLM_MODEL and LLM_API_KEY
# Keep stub here so a clean clone runs without a key; set gemini in your own .env.
LLM_PROVIDER=stub
# Model identifier for the provider. Ignored by the stub. A current free-tier Gemini Flash
# model (check https://ai.google.dev/gemini-api/docs/models before changing):
LLM_MODEL=gemini-3.6-flash
# Never commit a real key. Set it only in your local .env (Google AI Studio API key).
LLM_API_KEY=
# Simulated provider latency for the stub, in milliseconds.
STUB_DELAY_MS=1500
# Price in USD per 1,000 tokens for LLM_MODEL, used to compute cost per call.
# 0 for the stub and the Gemini free tier; set from the provider's price list on a paid tier.
LLM_PRICE_PER_1K_PROMPT_TOKENS=0
LLM_PRICE_PER_1K_COMPLETION_TOKENS=0

# ---------- LLM resilience (requirement A5) ----------
# Timeout for each single provider call, in seconds.
LLM_TIMEOUT_SECONDS=30
# Whole-request budget in the gateway: rate-limit wait + all attempts + backoff. The agents'
# HttpLLMClient waits 5 s longer than this. Keep well under AGENT_MAX_WALL_CLOCK_SECONDS.
LLM_REQUEST_DEADLINE_SECONDS=60
# Retries after the first attempt, for timeouts, HTTP 429, 5xx and connection errors only.
LLM_MAX_RETRIES=3
# Exponential backoff with jitter: base * 2^(n-1), capped at max. A provider Retry-After
# hint is respected as a minimum.
LLM_BACKOFF_BASE_SECONDS=1
LLM_BACKOFF_MAX_SECONDS=10
# Circuit breaker: opens after this many consecutive provider failures...
LLM_CB_FAILURE_THRESHOLD=5
# ...and allows one trial call after this many seconds (half-open).
LLM_CB_RESET_SECONDS=30
# Client-side rate limit toward the provider, shared through Redis. Requests are spaced
# 60/N seconds apart. 4 stays under the lowest published free-tier Flash limit (5 RPM);
# check your project's actual limits in Google AI Studio before raising it.
LLM_MAX_REQUESTS_PER_MINUTE=4
# How long a request may wait for the rate limiter before failing with 503 rate_limited.
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=20
# Fault injection for demos and drills: off | timeout | error_500 | error_429.
# Makes EVERY provider call fail that way. Keep off; the gateway logs a warning when it is on.
LLM_FAULT_INJECTION=off

# ---------- Retrieval (corpus index) ----------
# Embedding model for the chunk index and for queries, run locally by fastembed (ONNX, CPU,
# no key). Files are cached in data/models/. Changing it makes `python -m ingest status`
# report the index as stale; rebuild with `python -m ingest build`.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---------- Agent loop limits (requirement A1) ----------
# A run that hits any limit stops and escalates instead of answering.
# Maximum graph steps (node executions) per run.
AGENT_MAX_STEPS=12
# Maximum tool calls (corpus search, clause lookup, request-field lookup) per run.
AGENT_MAX_TOOL_CALLS=20
# Wall-clock budget for the agent loop, in seconds. Must be below RUN_TIMEOUT_SECONDS (the
# worker's hard limit) so the agent can escalate cleanly before the worker marks the run failed.
AGENT_MAX_WALL_CLOCK_SECONDS=75
